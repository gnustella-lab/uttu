<Window x:Class="Uttu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:Uttu.ViewModels"
        mc:Ignorable="d"
        Title="Uttu Desktop · Social Content Copilot"
        Height="760" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="/Resources/app.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding AddMemoryCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Notification / Info Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Tabs Navigation & Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="MyTaskbarIcon"
                        ToolTipText="Uttu Desktop · Social Content Copilot"
                        IconSource="/Resources/app.ico"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#2B2B2B" BorderThickness="1">
                    <MenuItem Header="Open Uttu" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="Generate New Drafts" Command="{Binding GenerateDraftsCommand}"/>
                    <Separator Background="#2B2B2B"/>
                    <MenuItem Header="Exit" Command="{Binding ExitAppCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 0: HEADER BAR FLAT -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo Flat -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="U" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Uttu Desktop" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    <TextBlock Text=" · Social Content Copilot" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center/Right Channels & Quick Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Registered channels badge -->
                    <Border Background="#222222" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Channel: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedChannelDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Generate Drafts Now Button -->
                    <Button Style="{StaticResource FlatPrimaryButton}" Command="{Binding GenerateDraftsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="12"/>
                            <TextBlock Text="Generate Drafts Now" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: NOTIFICATION BANNER -->
        <Border Grid.Row="1" Background="#0C3B61" BorderBrush="#0078D7" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding HasInfoBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding InfoBannerMessage}" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0"
                        Cursor="Hand" FontSize="12" Margin="10,0,0,0" Command="{Binding DismissBannerCommand}"/>
            </Grid>
        </Border>

        <!-- 2: TABS NAVIGATION & CONTENT -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- TAB 1: DRAFTS -->
            <TabItem Style="{StaticResource FlatTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Drafts ("/>
                        <TextBlock Text="{Binding DraftsCount}"/>
                        <TextBlock Text=")"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="18">
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding DraftsCount, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="No pending drafts at the moment." FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Click 'Generate Drafts Now' or wait for the scheduled proactive notification."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource FlatPrimaryButton}" Content="⚡ Generate New Drafts"
                                Command="{Binding GenerateDraftsCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Drafts List (VirtualizingStackPanel) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Drafts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Margin="0,0,0,16" Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Header do cartão -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Conteúdo do post -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Refinamento inline -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Ações -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header do Cartão -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Plataforma Badge -->
                                                <Border Grid.Column="0" Background="#262626" BorderBrush="{Binding Platform, Converter={StaticResource PlatformToBrush}}"
                                                        BorderThickness="1" Padding="8,3" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding PlatformBadge}" Foreground="{Binding Platform, Converter={StaticResource PlatformToBrush}}"
                                                               FontWeight="SemiBold" FontSize="11" FontFamily="Consolas"/>
                                                </Border>

                                                <!-- Tema -->
                                                <TextBlock Grid.Column="1" Text="{Binding Theme}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                                <!-- Contador de Caracteres -->
                                                <Border Grid.Column="2" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,3">
                                                    <TextBlock Text="{Binding CharCountDisplay}"
                                                               Foreground="{Binding IsOverLimit, Converter={StaticResource OverLimitToBrush}}"
                                                               FontFamily="Consolas" FontSize="12"/>
                                                </Border>
                                            </Grid>

                                            <!-- Conteúdo do Post (TextBox Flat Editável) -->
                                            <TextBox Grid.Row="1" Style="{StaticResource FlatTextBox}"
                                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240"
                                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" FontSize="14"/>

                                            <!-- Inline Refinement -->
                                            <Grid Grid.Row="2" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Refine: " Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                                         Text="{Binding RefinePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="E.g. make it punchier, change hook, add concrete numbers..." Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Style="{StaticResource FlatSecondaryButton}" Content="Refine"
                                                        Command="{Binding DataContext.RefineDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <!-- Actions (Discard, Generate Card, Approve, Publish) -->
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Discard -->
                                                <Button Grid.Column="0" Style="{StaticResource FlatDangerButton}" Content="Discard (Del)"
                                                        Command="{Binding DataContext.DiscardDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Generate 1600x900 Card & Buffer Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource FlatSecondaryButton}" Content="Generate 1600×900 Card"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.GenerateCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    
                                                    <Button Style="{StaticResource FlatSecondaryButton}" Content="Publish Immediately"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.PublishNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Style="{StaticResource FlatPrimaryButton}" Content="✓ APPROVE (Ctrl+Enter)"
                                                            Command="{Binding DataContext.ApproveDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: MEMORIES & GUIDELINES -->
            <TabItem Style="{StaticResource FlatTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Memories &amp; Guidelines ("/>
                        <TextBlock Text="{Binding ActiveMemoriesCount}"/>
                        <TextBlock Text=")"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <!-- Add New Memory -->
                        <RowDefinition Height="Auto"/>
                        <!-- Category Filters -->
                        <RowDefinition Height="Auto"/>
                        <!-- Memories Grid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add New Memory Inline -->
                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewMemoryText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Enter a new rule, engineering lesson, or tone guideline..." Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="1" SelectedValue="{Binding NewMemoryCategory}" SelectedValuePath="Content"
                                      Background="{StaticResource SurfaceBgBrush}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                      Margin="0,0,10,0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Hooks" IsSelected="True"/>
                                <ComboBoxItem Content="Tone"/>
                                <ComboBoxItem Content="Rules"/>
                                <ComboBoxItem Content="Formatting"/>
                            </ComboBox>

                            <Button Grid.Column="2" Style="{StaticResource FlatPrimaryButton}" Content="+ Add Memory (Ctrl+N)"
                                    Command="{Binding AddMemoryCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Category Filters -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="All" GroupName="CatFilter" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,12,0"
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="All"/>
                        <RadioButton Content="Hooks" GroupName="CatFilter" Foreground="#FFFFFF" Margin="0,0,12,0"
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Hooks"/>
                        <RadioButton Content="Tone" GroupName="CatFilter" Foreground="#FFFFFF" Margin="0,0,12,0"
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Tone"/>
                        <RadioButton Content="Rules" GroupName="CatFilter" Foreground="#FFFFFF" Margin="0,0,12,0"
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Rules"/>
                        <RadioButton Content="Formatting" GroupName="CatFilter" Foreground="#FFFFFF" Margin="0,0,12,0"
                                     Command="{Binding FilterCategoryCommand}" CommandParameter="Formatting"/>
                    </StackPanel>

                    <!-- Memories List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredMemories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Toggle Active/Inactive -->
                                            <CheckBox Grid.Column="0" Style="{StaticResource FlatCheckBox}"
                                                      IsChecked="{Binding IsActive}" Margin="0,0,12,0"
                                                      Command="{Binding DataContext.ToggleMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="1" Background="#282828" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" Padding="4,2" Margin="0,0,12,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontFamily="Consolas"/>
                                            </Border>

                                            <!-- Memory Text -->
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="#FFFFFF" FontSize="13"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="3" Style="{StaticResource FlatDangerButton}" Content="Delete"
                                                    Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: VOICE PROFILE -->
            <TabItem Style="{StaticResource FlatTabItem}" Header="Voice Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18">
                    <StackPanel>
                        <!-- Introduction -->
                        <TextBlock Text="Local Tone &amp; Style Calibration" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Paste 3 to 10 authentic previous posts so Uttu can extract your linguistic metrics, hook style, and vocabulary."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,14"/>

                        <!-- Sample Posts Editor -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Previous Sample Posts (separate with '---'):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding SamplePostsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="220" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FlatSecondaryButton}" Content="Save Calibration" Margin="0,0,10,0"
                                            Command="{Binding SaveVoiceCommand}"/>
                                    <Button Style="{StaticResource FlatPrimaryButton}" Content="⚡ Analyze &amp; Calibrate Tone"
                                            Command="{Binding CalibrateVoiceCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Extracted Linguistic Metrics -->
                        <TextBlock Text="Extracted Linguistic Metrics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <!-- Card 1: Sentence -->
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Average Words / Sentence" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding VoiceProfile.AvgSentenceLength, StringFormat='{}{0} words'}"
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Punctuation -->
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Punctuation Density" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding VoiceProfile.PunctuationDensity, StringFormat='{}{0} marks/100 words'}"
                                               FontSize="22" FontWeight="Bold" Foreground="#00CC6A" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Hook Style -->
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Dominant Hook Style" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding VoiceProfile.HookStyle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Prohibited Words &amp; Buzzwords in Drafts:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding VoiceProfile.ProhibitedWords, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Tone Keywords:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding VoiceProfile.ToneKeywords, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: CARD GENERATOR (1600x900) -->
            <TabItem Style="{StaticResource FlatTabItem}" Header="Card Generator (1600×900)">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="Dark Background (#0C0D0E)" Style="{StaticResource FlatCheckBox}"
                                      IsChecked="{Binding CardPreviewDarkMode}" Margin="0,0,20,0"/>

                            <Button Grid.Column="1" Style="{StaticResource FlatSecondaryButton}" Content="Open Cache Folder (%LocalAppData%\Uttu\cache)"
                                    Command="{Binding OpenCacheFolderCommand}"/>

                            <TextBlock Grid.Column="2" Text="Rendered natively with SkiaSharp at 1600×900 with zero Chromium RAM overhead"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Image Preview -->
                    <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding CardPreviewPath}" Stretch="Uniform" Margin="20"/>
                            
                            <!-- Placeholder if no image generated yet -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding CardPreviewPath, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="No 1600×900 card generated yet." FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="In the 'Drafts' tab, click 'Generate 1600×900 Card' to render instantly."
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: SETTINGS & BUFFER MCP -->
            <TabItem Style="{StaticResource FlatTabItem}" Header="Buffer MCP &amp; Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18">
                    <StackPanel>
                        <!-- Section 1: Buffer MCP Integration -->
                        <TextBlock Text="Buffer Model Context Protocol (MCP) Integration" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Uttu runs the Buffer MCP server in the background as a managed child process via Stdio (JSON-RPC 2.0)."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,14"/>

                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="MCP Status: " FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding McpStatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatSecondaryButton}" Content="Reconnect MCP Process"
                                            Command="{Binding ReconnectMcpCommand}"/>
                                </Grid>

                                <!-- Buffer API Status Card -->
                                <Border Background="#1C2833" BorderBrush="#0078D7" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Buffer API (api.bufferapp.com):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding BufferUserDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource FlatPrimaryButton}" Content="⚡ Test API Connection"
                                                Command="{Binding TestBufferTokenCommand}" Padding="12,6" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Buffer Access Token (Protected with Windows DPAPI):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding BufferTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Paste your Buffer Access Token here..." Margin="0,0,0,12"/>

                                <TextBlock Text="Buffer MCP Server Command:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding Settings.BufferMcpCommand, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="'internal' for built-in Node server, or executable path..." Margin="0,0,0,6"/>
                                <TextBlock Text="Default: 'internal' (runs Server/buffer-mcp.js with Job Object isolation and no open network ports)."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,14"/>

                                <TextBlock Text="Channels Detected in Buffer:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding BufferProfiles}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252525" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource FlatCheckBox}" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedService}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding FormattedUsername}" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,2">
                                                        <TextBlock Text="{Binding QueueStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Real-time Buffer Queue -->
                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pending Posts in Buffer Queue:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource FlatSecondaryButton}" Content="↻ Refresh Queue"
                                            Command="{Binding RefreshBufferQueueCommand}" Padding="8,4" FontSize="11"/>
                                </Grid>

                                <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" MinHeight="60">
                                    <StackPanel>
                                        <TextBlock Text="No pending posts in Buffer queue for selected channels."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Visibility="{Binding PendingQueueCount, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        
                                        <ItemsControl ItemsSource="{Binding PendingBufferUpdates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#202020" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding ServiceName}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding ProfileName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding DueAtFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource FlatDangerButton}" Content="Cancel Post"
                                                                        Padding="6,2" FontSize="10"
                                                                        Command="{Binding DataContext.DestroyBufferUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="12"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Proactive Automation and Toast Notifications -->
                        <TextBlock Text="Proactive Automation &amp; Windows 10 Notifications" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Style="{StaticResource FlatCheckBox}" Content="Enable daily proactive morning generation"
                                          IsChecked="{Binding Settings.AutoGenerateDaily}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Daily Trigger Time: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FlatTextBox}" Text="{Binding Settings.NotificationTime, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="(Triggers background ideation and sends Toast with one-click approval)"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Artificial Intelligence Engine -->
                        <TextBlock Text="Artificial Intelligence Engine (Optional LLM)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AI Provider:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Settings.AiProvider}" SelectedValuePath="Content"
                                          Background="{StaticResource SurfaceBgBrush}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Local Heuristic / Native Engine (Offline)"/>
                                    <ComboBoxItem Content="OpenAI (GPT-4o-mini)"/>
                                    <ComboBoxItem Content="Anthropic Claude"/>
                                    <ComboBoxItem Content="Google Gemini"/>
                                    <ComboBoxItem Content="Local Ollama (http://localhost:11434)"/>
                                </ComboBox>

                                <TextBlock Text="API Key (Protected with Windows DPAPI):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding AiApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Leave blank to use the native offline algorithmic engine..." Margin="0,0,0,12"/>

                                <TextBlock Text="Model Name (Optional):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource FlatTextBox}" Text="{Binding Settings.AiModel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Save Settings Button -->
                        <Button Style="{StaticResource FlatPrimaryButton}" Content="Save Settings &amp; Update Subsystems"
                                Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" Padding="20,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 3: FLAT NATIVE STATUS BAR -->
        <Border Grid.Row="3" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MCP Connection Status & Next Run -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding McpStatusText}" Foreground="#FFFFFF" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="|   Next run: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding NextRunText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>

                <!-- RAM & Native Version -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RamText}" Foreground="#00CC6A" FontFamily="Consolas" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="Uttu v1.0 Native · Windows 10" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
